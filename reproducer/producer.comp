#version 450

// Populate physical mip 4 with deterministic non-zero values.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(r32f, set = 0, binding = 0) uniform writeonly image2D outMip4;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outMip4);
    if (any(greaterThanEqual(p, size)))
        return;

    float value = 0.9 + float((p.x + p.y) & 255) * 0.0001;
    imageStore(outMip4, p, vec4(value));
}
